; Instalador de Ryxus Player para Windows (Inno Setup 6).
;
; CMake genera el .iss real a partir de esta plantilla sustituyendo la version
; y las rutas; se compila con `cmake --build build --target installer`.

#define AppName        "Ryxus Player"
#define AppVersion     "@PROJECT_VERSION@"
#define AppPublisher   "michelinlabs"
#define AppURL         "https://github.com/michelinlabs/ryxus-player"
#define AppExeName     "RyxusPlayer.exe"
; El identificador NO cambia al renombrar el programa: es por lo que el
; instalador reconoce (y reemplaza) una instalacion anterior, incluidas las
; que se llamaban Roxas Player.
#define AppIdRaw       "8F2C4E71-3A6D-4B9E-9C1F-7D5A2E8B4C60"

[Setup]
AppId={{{#AppIdRaw}}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppURL}
AppSupportURL={#AppURL}/issues
AppUpdatesURL={#AppURL}/releases
; Ver PreferredDir/PreferredGroup en [Code]: se reutiliza la ubicacion de la
; instalacion anterior salvo que lleve el nombre viejo del programa.
DefaultDirName={code:PreferredDir}
DefaultGroupName={code:PreferredGroup}
UsePreviousAppDir=no
UsePreviousGroup=no
UninstallDisplayName={#AppName}
UninstallDisplayIcon={app}\ryxus.ico
AppComments=Reproductor de audio con ecualizador y editor de etiquetas
AppContact={#AppURL}/issues
AppReadmeFile={app}\README.md
VersionInfoVersion={#AppVersion}
VersionInfoCompany={#AppPublisher}
VersionInfoProductName={#AppName}
VersionInfoDescription=Instalador de {#AppName}

; Explicitos aunque sean el valor por defecto: son los dos ajustes de los
; que depende que el programa salga en "Aplicaciones instaladas" y se
; pueda quitar desde ahi.
Uninstallable=yes
CreateUninstallRegKey=yes

; Si el reproductor esta abierto durante la actualizacion, sus archivos
; estan bloqueados y no se pueden reemplazar. Con esto el instalador lo
; cierra por su cuenta en vez de fallar a medias.
CloseApplications=yes
RestartApplications=no

LicenseFile=@CMAKE_CURRENT_SOURCE_DIR@\LICENSE
SetupIconFile=@CMAKE_CURRENT_SOURCE_DIR@\res\ryxus.ico
OutputDir=@RYXUS_INSTALLER_DIR@
OutputBaseFilename=RyxusPlayer-@PROJECT_VERSION@-win64-setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

; Por defecto se instala para todo el equipo. Es lo que hace que la entrada
; de desinstalacion quede en HKLM, que es donde miran el panel de control y
; los desinstaladores de terceros; una instalacion solo-para-mi la escribe
; en HKCU y hay herramientas que no la enumeran. Quien no tenga permisos de
; administrador puede seguir eligiendo la instalacion personal en el
; asistente.
PrivilegesRequired=admin
PrivilegesRequiredOverridesAllowed=dialog commandline

[Languages]
Name: "es"; MessagesFile: "compiler:Languages\Spanish.isl"
Name: "en"; MessagesFile: "compiler:Default.isl"

[Tasks]
; Marcado por defecto: es lo que espera casi todo el mundo al instalar, y
; dejarlo en "unchecked" hacia que mucha gente terminara sin acceso directo
; creyendo despues que se le habia borrado.
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; \
    GroupDescription: "{cm:AdditionalIcons}"
Name: "associate"; Description: "Asociar los formatos de audio con {#AppName}"; \
    GroupDescription: "Integracion con Windows:"; Flags: unchecked

[Files]
; Todo el arbol que dejo `cmake --install` (la exclusion de los compiladores
; de shaders de Direct3D ya se hace ahi).
Source: "@RYXUS_STAGE_DIR@\*"; DestDir: "{app}"; \
    Flags: ignoreversion recursesubdirs createallsubdirs

; Icono suelto al que apuntan los accesos directos (ver [Icons]).
Source: "@CMAKE_CURRENT_SOURCE_DIR@\res\ryxus.ico"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
; Los accesos directos declaran icono y carpeta de trabajo de forma
; explicita. Sin IconFilename, Windows tiene que sacar el icono del propio
; .exe cada vez que reconstruye su cache -- tipicamente al reiniciar -- y si
; eso falla, el acceso directo se queda sin dibujo. Apuntando a un .ico
; suelto instalado junto al programa, el icono siempre tiene de donde salir.
Name: "{group}\{#AppName}"; Filename: "{app}\{#AppExeName}"; WorkingDir: "{app}"; IconFilename: "{app}\ryxus.ico"; IconIndex: 0; Comment: "Reproductor de audio {#AppName}"
Name: "{group}\{cm:UninstallProgram,{#AppName}}"; Filename: "{uninstallexe}"; IconFilename: "{app}\ryxus.ico"; IconIndex: 0; Comment: "Quitar {#AppName} del equipo"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExeName}"; WorkingDir: "{app}"; IconFilename: "{app}\ryxus.ico"; IconIndex: 0; Comment: "Reproductor de audio {#AppName}"; Tasks: desktopicon

[Registry]
; "Abrir con" y, si se marca la tarea, asociacion de los formatos soportados.
Root: HKA; Subkey: "Software\Classes\Applications\{#AppExeName}\shell\open\command"; \
    ValueType: string; ValueName: ""; \
    ValueData: """{app}\{#AppExeName}"" ""%1"""; Flags: uninsdeletekey

Root: HKA; Subkey: "Software\Classes\RyxusPlayer.Audio"; \
    ValueType: string; ValueName: ""; ValueData: "Archivo de audio"; \
    Flags: uninsdeletekey; Tasks: associate
Root: HKA; Subkey: "Software\Classes\RyxusPlayer.Audio\DefaultIcon"; \
    ValueType: string; ValueName: ""; ValueData: "{app}\ryxus.ico,0"; \
    Flags: uninsdeletekey; Tasks: associate
Root: HKA; Subkey: "Software\Classes\RyxusPlayer.Audio\shell\open\command"; \
    ValueType: string; ValueName: ""; ValueData: """{app}\{#AppExeName}"" ""%1"""; \
    Flags: uninsdeletekey; Tasks: associate

Root: HKA; Subkey: "Software\Classes\.mp3";  ValueType: string; ValueName: ""; ValueData: "RyxusPlayer.Audio"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.flac"; ValueType: string; ValueName: ""; ValueData: "RyxusPlayer.Audio"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.wav";  ValueType: string; ValueName: ""; ValueData: "RyxusPlayer.Audio"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.ogg";  ValueType: string; ValueName: ""; ValueData: "RyxusPlayer.Audio"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.m4a";  ValueType: string; ValueName: ""; ValueData: "RyxusPlayer.Audio"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.opus"; ValueType: string; ValueName: ""; ValueData: "RyxusPlayer.Audio"; Flags: uninsdeletevalue; Tasks: associate

[Run]
Filename: "{app}\{#AppExeName}"; \
    Description: "{cm:LaunchProgram,{#AppName}}"; \
    Flags: nowait postinstall skipifsilent

[UninstallDelete]
; La configuracion del usuario (temas, listas, carpetas) no se toca al
; desinstalar: si se reinstala, sigue ahi.
Type: dirifempty; Name: "{app}"

[Code]
//
//  Actualizacion sobre una instalacion anterior.
//
//  La 1.0.0 se instalaba solo para el usuario, bajo %LocalAppData%\Programs, y
//  registraba su desinstalacion en HKCU. La 1.1.0 paso a instalarse para todo
//  el equipo, en Archivos de programa y con la clave en HKLM. Al no compartir
//  ni carpeta ni rama del registro, Inno no encontraba la instalacion vieja:
//  se quedaban las dos conviviendo y los accesos directos de antes seguian
//  abriendo el programa viejo. De ahi que "no se actualizara".
//
//  Aqui se busca cualquier instalacion previa con el mismo AppId -- en las dos
//  vistas del registro y en las dos ramas -- y se desinstala antes de instalar.

const
  UninstallSubkey =
    'Software\Microsoft\Windows\CurrentVersion\Uninstall\{{#AppIdRaw}}_is1';

//  Carpeta de instalacion y grupo del menu inicio que se proponen.
//
//  Inno reutiliza por su cuenta los de la instalacion anterior. Tras cambiar
//  el nombre del programa eso lo dejaba metido en "Roxas Player", con el grupo
//  del menu inicio igual: se actualizaba bien, pero con el rotulo viejo por
//  todas partes. Por eso se desactiva (UsePreviousAppDir/Group) y se decide
//  aqui: se hereda lo anterior solo si no lleva el nombre antiguo, de modo que
//  una carpeta elegida a mano por el usuario se sigue respetando.

function PreviousSetting(ValueName: String): String;
begin
  Result := '';
  if RegQueryStringValue(HKLM, UninstallSubkey, ValueName, Result) then
    Exit;
  if RegQueryStringValue(HKLM32, UninstallSubkey, ValueName, Result) then
    Exit;
  if not RegQueryStringValue(HKCU, UninstallSubkey, ValueName, Result) then
    Result := '';
end;

function PreferredDir(Param: String): String;
var
  Previous: String;
begin
  Previous := PreviousSetting('Inno Setup: App Path');
  if (Previous <> '') and (Pos('Roxas', ExtractFileName(Previous)) = 0) then
    Result := Previous
  else
    Result := ExpandConstant('{autopf}\{#AppName}');
end;

function PreferredGroup(Param: String): String;
var
  Previous: String;
begin
  Previous := PreviousSetting('Inno Setup: Icon Group');
  if (Previous <> '') and (Pos('Roxas', Previous) = 0) then
    Result := Previous
  else
    Result := '{#AppName}';
end;

function PreviousUninstaller(RootKey: Integer): String;
var
  Value: String;
begin
  Result := '';
  if RegQueryStringValue(RootKey, UninstallSubkey, 'UninstallString', Value) then
    Result := RemoveQuotes(Value);
end;

procedure RemovePreviousVersion(RootKey: Integer);
var
  Uninstaller: String;
  ResultCode, Waited: Integer;
begin
  Uninstaller := PreviousUninstaller(RootKey);
  if (Uninstaller = '') or (not FileExists(Uninstaller)) then
    Exit;

  if not Exec(Uninstaller, '/VERYSILENT /SUPPRESSMSGBOXES /NORESTART',
              '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
    Exit;

  //  El desinstalador de Inno se copia al temporal y se relanza desde ahi, asi
  //  que Exec vuelve antes de que haya terminado de verdad. Se espera a que
  //  desaparezca su propio ejecutable, con un tope de 60 s por si se atasca.
  Waited := 0;
  while FileExists(Uninstaller) and (Waited < 60000) do
  begin
    Sleep(250);
    Waited := Waited + 250;
  end;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  RemovePreviousVersion(HKLM);
  RemovePreviousVersion(HKLM32);
  RemovePreviousVersion(HKCU);
  Result := '';
end;
