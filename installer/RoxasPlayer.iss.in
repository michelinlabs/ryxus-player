; Instalador de Roxas Player para Windows (Inno Setup 6).
;
; CMake genera el .iss real a partir de esta plantilla sustituyendo la version
; y las rutas; se compila con `cmake --build build --target installer`.

#define AppName        "Roxas Player"
#define AppVersion     "@PROJECT_VERSION@"
#define AppPublisher   "michelinlabs"
#define AppURL         "https://github.com/michelinlabs/roxas-player"
#define AppExeName     "RoxasPlayer.exe"

[Setup]
AppId={{8F2C4E71-3A6D-4B9E-9C1F-7D5A2E8B4C60}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppURL}
AppSupportURL={#AppURL}/issues
AppUpdatesURL={#AppURL}/releases
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
UninstallDisplayName={#AppName}
UninstallDisplayIcon={app}\{#AppExeName}
LicenseFile=@CMAKE_CURRENT_SOURCE_DIR@\LICENSE
SetupIconFile=@CMAKE_CURRENT_SOURCE_DIR@\res\roxas.ico
OutputDir=@ROXAS_INSTALLER_DIR@
OutputBaseFilename=RoxasPlayer-@PROJECT_VERSION@-win64-setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

; Sin privilegios de administrador se instala solo para el usuario actual;
; el asistente deja elegir. Asi no hace falta elevar para probarlo.
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog

[Languages]
Name: "es"; MessagesFile: "compiler:Languages\Spanish.isl"
Name: "en"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; \
    GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "associate"; Description: "Asociar los formatos de audio con {#AppName}"; \
    GroupDescription: "Integracion con Windows:"; Flags: unchecked

[Files]
; Todo el arbol que dejo `cmake --install` (la exclusion de los compiladores
; de shaders de Direct3D ya se hace ahi).
Source: "@ROXAS_STAGE_DIR@\*"; DestDir: "{app}"; \
    Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\{#AppExeName}"
Name: "{group}\{cm:UninstallProgram,{#AppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExeName}"; Tasks: desktopicon

[Registry]
; "Abrir con" y, si se marca la tarea, asociacion de los formatos soportados.
Root: HKA; Subkey: "Software\Classes\Applications\{#AppExeName}\shell\open\command"; \
    ValueType: string; ValueName: ""; \
    ValueData: """{app}\{#AppExeName}"" ""%1"""; Flags: uninsdeletekey

Root: HKA; Subkey: "Software\Classes\RoxasPlayer.Audio"; \
    ValueType: string; ValueName: ""; ValueData: "Archivo de audio"; \
    Flags: uninsdeletekey; Tasks: associate
Root: HKA; Subkey: "Software\Classes\RoxasPlayer.Audio\DefaultIcon"; \
    ValueType: string; ValueName: ""; ValueData: "{app}\{#AppExeName},0"; \
    Flags: uninsdeletekey; Tasks: associate
Root: HKA; Subkey: "Software\Classes\RoxasPlayer.Audio\shell\open\command"; \
    ValueType: string; ValueName: ""; ValueData: """{app}\{#AppExeName}"" ""%1"""; \
    Flags: uninsdeletekey; Tasks: associate

Root: HKA; Subkey: "Software\Classes\.mp3";  ValueType: string; ValueName: ""; ValueData: "RoxasPlayer.Audio"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.flac"; ValueType: string; ValueName: ""; ValueData: "RoxasPlayer.Audio"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.wav";  ValueType: string; ValueName: ""; ValueData: "RoxasPlayer.Audio"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.ogg";  ValueType: string; ValueName: ""; ValueData: "RoxasPlayer.Audio"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.m4a";  ValueType: string; ValueName: ""; ValueData: "RoxasPlayer.Audio"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.opus"; ValueType: string; ValueName: ""; ValueData: "RoxasPlayer.Audio"; Flags: uninsdeletevalue; Tasks: associate

[Run]
Filename: "{app}\{#AppExeName}"; \
    Description: "{cm:LaunchProgram,{#AppName}}"; \
    Flags: nowait postinstall skipifsilent

[UninstallDelete]
; La configuracion del usuario (temas, listas, carpetas) no se toca al
; desinstalar: si se reinstala, sigue ahi.
Type: dirifempty; Name: "{app}"
