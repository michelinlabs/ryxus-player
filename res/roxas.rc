// Recurso de Windows: el icono que muestran el Explorador, la barra de tareas
// y el menu inicio. Sin esto el .exe sale con el icono generico, aunque la
// ventana si tenga el suyo (Qt lo pone en tiempo de ejecucion).
#define IDI_ROXAS_ICON 101

// El primer icono por orden de ID es el que Windows usa para el ejecutable.
IDI_ROXAS_ICON ICON "roxas.ico"

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     1,1,0,0
    PRODUCTVERSION  1,1,0,0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       0
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0a04b0"
        BEGIN
            VALUE "CompanyName",      "michelinlabs"
            VALUE "FileDescription",  "Roxas Player"
            VALUE "FileVersion",      "1.1.0"
            VALUE "InternalName",     "RoxasPlayer"
            VALUE "LegalCopyright",   "Copyright (c) 2026 michelinlabs. Licencia MIT."
            VALUE "OriginalFilename", "RoxasPlayer.exe"
            VALUE "ProductName",      "Roxas Player"
            VALUE "ProductVersion",   "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c0a, 1200
    END
END
